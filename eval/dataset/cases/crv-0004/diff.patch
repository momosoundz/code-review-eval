+# Words that make a question lean on the previous turn: "tell me more about that".
+REFERENCE_WORDS = {"that", "it", "this", "these", "those", "there", "more", "again", "same", "also"}
+
+
+def refers_to_previous_turn(question: str) -> bool:
+    words = set(re.findall(r"[a-z']+", question))
+    return bool(words & REFERENCE_WORDS)
+
 
